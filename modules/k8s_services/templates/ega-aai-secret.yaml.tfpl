# Just apply as is, currently we are not processing files stored at EGA.
apiVersion: v1
kind: Secret
metadata:
  name: ega-aai-secret
  namespace: ${namespace}
type: Opaque
data:
  EGA_AAI_CLIENT_ID: ${base64encode("dummy-value")}
  EGA_AAI_CLIENT_SECRET: ${base64encode("dummy-value")}
  EGA_AAI_USERNAME: ${base64encode("dummy-value")}
  EGA_AAI_PASSWORD ${base64encode("dummy-value")}