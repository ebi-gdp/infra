apiVersion: v1
kind: Secret
metadata:
  name: basic-auth-secret
  namespace: ${namespace}
type: Opaque
data:
  BASIC_AUTH_USERNAME: ${base64encode(basic_auth_secret.BASIC_AUTH_USERNAME)}
  BASIC_AUTH_PASSWORD: ${base64encode(basic_auth_secret.BASIC_AUTH_PASSWORD)}
  USER_MANAGER_BASIC_AUTH: ${base64encode(
    format("Basic %s", base64encode(
      format("%s:%s", basic_auth_secret.BASIC_AUTH_USERNAME, basic_auth_secret.BASIC_AUTH_PASSWORD)
    ))
  )}
  FILE_HANDLER_BASIC_AUTH: ${base64encode(
    format("Basic %s", base64encode(
      format("%s:%s", basic_auth_secret.BASIC_AUTH_USERNAME, basic_auth_secret.BASIC_AUTH_PASSWORD)
    ))
  )}
  SEC_KEY_PASSWD: ${base64encode(basic_auth_secret.SEC_KEY_PASSWORD)}