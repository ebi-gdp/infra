apiVersion: v1
kind: Secret
metadata:
  name: globus-secret
  namespace: ${namespace}
type: Opaque
data:
  GLOBUS_CLIENT_ID: ${base64encode(globus_secret.GLOBUS_CLIENT_ID)}
  GLOBUS_CLIENT_SECRET: ${base64encode(globus_secret.GLOBUS_CLIENT_SECRET)}
  GLOBUS_AUTH_API_CREDENTIALS: ${base64encode(
      format("%s:%s", globus_secret.GLOBUS_CLIENT_ID, globus_secret.GLOBUS_CLIENT_SECRET)
    )}
