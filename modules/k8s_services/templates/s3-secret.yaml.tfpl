# not used in pure GCP deployments (hybrid deployments only)
apiVersion: v1
kind: Secret
metadata:
  name: s3-secret
  namespace: ${namespace}
type: Opaque
data:
  EMBASSY_S3_ACCESS_KEY_ID: ${base64encode("dummy-value")}
  EMBASSY_S3_SECRET_ACCESS_KEY: ${base64encode("dummy-value")}
  ALLAS_S3_ACCESS_KEY_ID: ${base64encode("dummy-value")}
  ALLAS_S3_SECRET_ACCESS_KEY: ${base64encode("dummy-value")}